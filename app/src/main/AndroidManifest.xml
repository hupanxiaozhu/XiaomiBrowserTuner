<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 只用于「从 URL 导入拦截规则」，模块自身不联网做别的事 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        包可见性声明（Android 11+ 必需）。

        本模块 targetSdk 34，读宿主版本号走 PackageManager#getPackageInfo。从 Android 11 起
        系统按「包可见性」过滤这类查询：没在这里声明过的包一律看不见，getPackageInfo 会抛
        NameNotFoundException —— 即使宿主明明装着。

        症状就是功能页顶部那张卡显示「小米浏览器 未安装」而功能实际生效：hook 与 DEX 加载
        不走 PackageManager，只有模块进程里查别的应用会中招。

        注意：隐藏应用列表（HMA）这类模块会在应用侧再过滤一层，声明 queries 挡不住它。
    -->
    <queries>
        <package android:name="com.android.browser" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HookBrowser"
        android:usesCleartextTraffic="true">

        <!-- 模块设置入口。1.11.0 起界面是 Compose（三 Tab + 二级页）；
             1.12.0 起规则管理也并进同一个 Activity（原来的 RuleManagerActivity 已删除）。 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            框架服务入口（1.10.1 新增，必需）。

            宿主进程读开关走 `XposedInterface#getRemotePreferences`，读的是**框架数据库**；
            模块 App 要把开关写进去，只能先从这个 ContentProvider 拿到框架送来的
            `IXposedService` binder（`XposedServiceHelper` 内部接收），再经它写远端组。

            少声明这个 provider 的后果：界面上开关看起来正常，宿主侧永远读到空表 ——
            「改了不生效」且**不报任何错**（1.10.0 就是这个状态）。

            authorities 必须是 `${applicationId}.XposedService`：框架按这个约定来找 provider，
            写错同样是静默失效（见 ModuleService）。
        -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!--
            Xposed 模块声明。

            1.10.0：旧的 xposedmodule / xposedminversion / xposedscope meta-data 全部删除。
            libxposed API 101+ 的模块身份由 APK 里的 META-INF/xposed/ 目录声明，不再看 manifest：

              META-INF/xposed/module.prop      模块描述（minApiVersion / targetApiVersion / staticScope）
              META-INF/xposed/java_init.list   入口类名（com.hupan.hookbrowser.MainHook）
              META-INF/xposed/scope.list       作用域包名（com.android.browser）

            两者不能混用：留着旧声明会让 LSPosed 按「legacy 模块」加载，而 legacy 通道正是
            那条依赖跨进程读 prefs 文件的老路 —— 开关会读不到，详见 Config 的版本对照表。
            scope 也一并挪到 scope.list，res/values/arrays.xml 里的字符串数组已删除。
        -->
    </application>

</manifest>
