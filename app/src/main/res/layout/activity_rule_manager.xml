<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mx_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="10dp"
        android:text="@string/rule_mgr_title"
        android:textColor="@color/mx_text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_rule_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mx_card"
        android:lineSpacingExtra="3dp"
        android:padding="14dp"
        android:text="@string/rule_mgr_info_init"
        android:textColor="@color/mx_text_primary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/btn_import_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/rule_mgr_from_url" />

        <Button
            android:id="@+id/btn_import_file"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/rule_mgr_from_file" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_rule_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="4dp"
        android:padding="24dp"
        android:text="@string/rule_mgr_empty"
        android:textColor="@color/mx_text_secondary"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/list_rule_sets"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_mx_card"
        android:divider="@color/mx_divider"
        android:dividerHeight="1dp" />

</LinearLayout>
