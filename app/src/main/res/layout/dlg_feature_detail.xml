<?xml version="1.0" encoding="utf-8"?>
<!-- 点开关行里「开关以外的区域」弹出的详情卡：状态 + 作用 / Hook 目标 / 生效方式 / 注意事项 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="4dp"
    android:paddingEnd="22dp">

    <!-- 状态胶囊：高 22dp、圆角 11dp（= 高/2），左右内边距 10dp、字号 11sp —— 三工程同一组参数。
         底色随开关状态在 bg_mx_pill / bg_mx_pill_off 之间切，由 PrefsFragment 带 220ms 过渡改。 -->
    <TextView
        android:id="@+id/tv_detail_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mx_pill"
        android:gravity="center"
        android:minHeight="22dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/mx_accent"
        android:textSize="11sp" />

    <TextView
        style="@style/MxDetailLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/detail_label_purpose" />

    <TextView
        android:id="@+id/tv_detail_purpose"
        style="@style/MxDetailBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        style="@style/MxDetailLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/detail_label_target" />

    <TextView
        android:id="@+id/tv_detail_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/mx_text_secondary"
        android:textSize="11sp" />

    <TextView
        style="@style/MxDetailLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/detail_label_effect" />

    <TextView
        android:id="@+id/tv_detail_effect"
        style="@style/MxDetailBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/box_detail_caveat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_mx_block"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/detail_label_caveat"
            android:textColor="@color/mx_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_detail_caveat"
            style="@style/MxDetailBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
