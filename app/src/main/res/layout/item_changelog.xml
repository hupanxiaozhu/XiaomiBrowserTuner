<?xml version="1.0" encoding="utf-8"?>
<!-- 更新日志的一条 —— **一版一张独立卡片**（对齐番茄 HookFanqie 的 ChangelogCard）：
     卡片圆角 20dp、内边距 18 / 14dp；标题行是「版本号 16sp 粗体 + versionCode 小字 + 右侧 tag 胶囊」，
     下面是「· 」开头的要点（圆点由 AboutFragment 拼进文本，主色圆点靠不上就是个普通中点，
     这里是纯 XML，做不到多色一段，所以圆点用文本字符，颜色跟着正文走）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_mx_card"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_cl_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mx_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_cl_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/mx_text_hint"
            android:textSize="11sp" />

        <!-- 状态 tag 胶囊：当前 = 浅蓝底主色字，历史 = 浅灰底次要字（与详情弹窗的状态胶囊同一组令牌） -->
        <TextView
            android:id="@+id/tv_cl_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_mx_pill"
            android:gravity="center"
            android:minHeight="22dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/mx_accent"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_cl_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/mx_text_secondary"
        android:textSize="13sp" />
</LinearLayout>
