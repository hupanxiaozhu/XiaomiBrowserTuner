<?xml version="1.0" encoding="utf-8"?>
<!-- 分区标题（PreferenceCategory 的 android:layout）：卡片之外的一行小字，不做成卡片。

     对齐番茄 HookFanqie 的 SectionHeader：14sp、次要色、贴在页面左边 24dp 处
     （= 页面留白 16dp + 8dp；卡片里的文字在 34dp，标题刻意比它更靠左一点）。
     上下间距不写在这里：上方那段落差由 CardRowDecoration 给 header 行的 top offset 控制。 -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:paddingBottom="2dp"
    android:textColor="@color/mx_text_secondary"
    android:textSize="14sp" />
