<?xml version="1.0" encoding="utf-8"?>
<!-- 开关行（ui/SwitchRowPreference 的 android:layout）——**一条一卡**。

     版式对齐番茄 HookFanqie 7.2.30 的 ToggleCard：卡片圆角 20dp（由 CardRowDecoration 画）、
     内边距 18 / 16dp、标题 16sp 粗体、副文案 13sp 次要色。

     开关本体在这儿自己放（MaterialSwitch），**不再**让库往 android:id/widget_frame 里注入：
     库注入的 SwitchCompat 是 android:clickable="false" 的，点它等于点整行，
     没法把「点开关 = 切换」和「点行 = 看详情」分成两条路。

     左右各 16dp 外边距 = 卡片外留白，CardRowDecoration 画的卡片正好落在这个边界内。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/bg_mx_row_ripple"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="14dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/mx_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:lineSpacingExtra="4dp"
            android:maxLines="3"
            android:textColor="@color/mx_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/hb_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:clickable="true"
        android:focusable="false"
        android:minHeight="48dp"
        android:minWidth="56dp" />
</LinearLayout>
