<?xml version="1.0" encoding="utf-8"?>
<!-- 「关于」页（底部导航的右栏）——版式对齐番茄 HookFanqie 7.2.30 的 AboutTab：
     hero 主卡（主色 12% 底 + 模块名大字 + 实心版本胶囊 + 一句话定位）
     → 简介卡 → 「项目信息」一组独立小卡（标签在上、取值加粗）→ 「更新日志」一版一卡。

     页面标题在顶部标题区，这里不再重复写一遍。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- ===== hero：应用主卡 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_mx_hero"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/mx_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!-- 版本胶囊：高 22dp → 圆角 11dp（stadium），与详情弹窗的状态胶囊同参数。
                         hero 底本身就是主色淡底，所以这里必须用实心主色 + 白字，否则看不见。 -->
                    <TextView
                        android:id="@+id/tv_about_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_mx_pill_solid"
                        android:gravity="center"
                        android:minHeight="22dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="@color/mx_on_accent"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_about_tagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/about_tagline"
                android:textColor="@color/mx_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ===== 简介 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_mx_card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tv_about_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="@string/about_intro"
                android:textColor="@color/mx_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ===== 项目信息 ===== -->
        <TextView
            style="@style/MxSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_section_info" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_mx_card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <TextView
                style="@style/MxInfoLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_lbl_host" />

            <TextView
                android:id="@+id/tv_about_host"
                style="@style/MxInfoValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_val_host" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_mx_card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <TextView
                style="@style/MxInfoLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_lbl_pkg" />

            <TextView
                android:id="@+id/tv_about_pkg"
                style="@style/MxInfoValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_val_pkg" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_mx_card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <TextView
                style="@style/MxInfoLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_lbl_scope" />

            <TextView
                android:id="@+id/tv_about_scope"
                style="@style/MxInfoValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_val_scope" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_mx_card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <TextView
                style="@style/MxInfoLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_lbl_runtime" />

            <TextView
                android:id="@+id/tv_about_runtime"
                style="@style/MxInfoValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_val_runtime" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_mx_card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <TextView
                style="@style/MxInfoLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_lbl_service" />

            <TextView
                android:id="@+id/tv_about_status"
                style="@style/MxInfoValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ===== 更新日志 ===== -->
        <TextView
            style="@style/MxSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_changelog" />

        <LinearLayout
            android:id="@+id/ll_changelog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tv_cl_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/about_cl_more"
            android:textColor="@color/mx_text_hint"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
