<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 开关行用自定义的 ui.SwitchRowPreference（继承 TwoStatePreference）：
         点开关 = 切换，点行里其它地方 = 弹详情（见 ui/FeatureDetails.kt）。
         用库自带的 SwitchPreferenceCompat 做不到 —— 它注入的开关是 clickable=false，
         而且它的 onClick 就是把整行点击当成切换。 -->

    <com.hupan.hookbrowser.ui.SwitchRowPreference
        android:layout="@layout/mx_pref_switch"
        app:defaultValue="true"
        app:key="master_enabled"
        app:summary="@string/pref_master_sum"
        app:title="@string/pref_master" />

    <PreferenceCategory
        android:layout="@layout/mx_pref_category"
        app:title="@string/group_ads">

        <com.hupan.hookbrowser.ui.SwitchRowPreference
            android:layout="@layout/mx_pref_switch"
            app:defaultValue="true"
            app:key="ad_splash"
            app:summary="@string/pref_ad_splash_sum"
            app:title="@string/pref_ad_splash" />

        <com.hupan.hookbrowser.ui.SwitchRowPreference
            android:layout="@layout/mx_pref_switch"
            app:defaultValue="true"
            app:key="ad_home_promo"
            app:summary="@string/pref_ad_home_promo_sum"
            app:title="@string/pref_ad_home_promo" />

        <com.hupan.hookbrowser.ui.SwitchRowPreference
            android:layout="@layout/mx_pref_switch"
            app:defaultValue="true"
            app:key="ad_search_sug"
            app:summary="@string/pref_ad_search_sug_sum"
            app:title="@string/pref_ad_search_sug" />

        <com.hupan.hookbrowser.ui.SwitchRowPreference
            android:layout="@layout/mx_pref_switch"
            app:defaultValue="true"
            app:key="ad_error_page_hot"
            app:summary="@string/pref_ad_error_page_hot_sum"
            app:title="@string/pref_ad_error_page_hot" />

        <com.hupan.hookbrowser.ui.SwitchRowPreference
            android:layout="@layout/mx_pref_switch"
            app:defaultValue="true"
            app:key="misc_host_ad"
            app:summary="@string/pref_misc_host_ad_sum"
            app:title="@string/pref_misc_host_ad" />

        <com.hupan.hookbrowser.ui.SwitchRowPreference
            android:layout="@layout/mx_pref_switch"
            app:defaultValue="true"
            app:key="ad_custom_rules"
            app:summary="@string/pref_ad_custom_rules_sum"
            app:title="@string/pref_ad_custom_rules" />

        <com.hupan.hookbrowser.ui.SwitchRowPreference
            android:layout="@layout/mx_pref_switch"
            app:defaultValue="false"
            app:key="ad_host_override"
            app:summary="@string/pref_ad_host_override_sum"
            app:title="@string/pref_ad_host_override" />

        <!-- 入口项（点开进规则管理页），不是开关：工具只把开关类的 key 纳入对齐检查 -->
        <Preference
            android:layout="@layout/mx_pref_link"
            app:key="rule_manager"
            app:summary="@string/pref_rule_manager_sum"
            app:title="@string/pref_rule_manager" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/mx_pref_category"
        app:title="@string/group_ui">

        <com.hupan.hookbrowser.ui.SwitchRowPreference
            android:layout="@layout/mx_pref_switch"
            app:defaultValue="true"
            app:key="ui_download"
            app:summary="@string/pref_ui_download_sum"
            app:title="@string/pref_ui_download" />

        <com.hupan.hookbrowser.ui.SwitchRowPreference
            android:layout="@layout/mx_pref_switch"
            app:defaultValue="true"
            app:key="ua_patch"
            app:summary="@string/pref_ua_patch_sum"
            app:title="@string/pref_ua_patch" />

        <ListPreference
            android:layout="@layout/mx_pref_link"
            app:defaultValue="chrome"
            app:dependency="ua_patch"
            app:entries="@array/ua_mode_entries"
            app:entryValues="@array/ua_mode_values"
            app:key="ua_mode"
            app:title="@string/pref_ua_mode" />

        <com.hupan.hookbrowser.ui.SwitchRowPreference
            android:layout="@layout/mx_pref_switch"
            app:defaultValue="true"
            app:key="ui_search_engine"
            app:summary="@string/pref_ui_search_engine_sum"
            app:title="@string/pref_ui_search_engine" />

        <ListPreference
            android:layout="@layout/mx_pref_link"
            app:defaultValue="bing"
            app:dependency="ui_search_engine"
            app:entries="@array/search_engine_entries"
            app:entryValues="@array/search_engine_values"
            app:key="ui_search_engine_target"
            app:title="@string/pref_search_engine_target" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/mx_pref_category"
        app:title="@string/group_advanced">

        <com.hupan.hookbrowser.ui.SwitchRowPreference
            android:layout="@layout/mx_pref_switch"
            app:defaultValue="false"
            app:key="misc_unlock_pref"
            app:summary="@string/pref_misc_unlock_pref_sum"
            app:title="@string/pref_misc_unlock_pref" />

        <com.hupan.hookbrowser.ui.SwitchRowPreference
            android:layout="@layout/mx_pref_switch"
            app:defaultValue="false"
            app:key="misc_debug"
            app:summary="@string/pref_misc_debug_sum"
            app:title="@string/pref_misc_debug" />

        <com.hupan.hookbrowser.ui.SwitchRowPreference
            android:layout="@layout/mx_pref_switch"
            app:defaultValue="false"
            app:key="misc_security"
            app:summary="@string/pref_misc_security_sum"
            app:title="@string/pref_misc_security" />

    </PreferenceCategory>

</PreferenceScreen>
