<?xml version="1.0" encoding="utf-8"?>
<!--
  MIUI X 主题（1.11.0 建立，1.12.0 收口）。

  界面已全部是 Compose（令牌真源是 ui/DesignTokens.kt），这里**只剩一样东西**：
  `Theme.HookBrowser` —— 应用主题，给 MainActivity 用（深浅色跟随系统，强调色取
  @color/mx_accent）。1.12.0 规则管理页也从 View 搬进 Compose 之后，@style 层面
  已经没有任何界面组件需要染色了，但这个主题仍必须留着：Activity 需要一个带
  DayNight 的窗口底色与状态栏 / 导航栏颜色。

  为旧版式写的那一批 style（MxCard / MxCardRow / MxCapsuleTag* / MxDetail* …）已随
  PreferenceFragmentCompat 一起删除：它们在 Compose 里的等价物是 ui/CatalogComponents.kt
  的 ToggleCard / StatusPill / DetailBody 等组件，不再需要 XML 样式。

  颜色一律引 @color/mx_*，尺寸引 @dimen/ds_*（res/values/design_tokens.xml，
  与多看同名文件逐值相同）—— 改样式改令牌一处，三工程跟着变。
-->
<resources>
    <!-- MIUI X：浅灰页面底 + 大圆角白卡片 + 蓝调强调色。
         colorControl* 这一组现在没有 Material 组件消费了（界面全是 Compose + miuix），
         留着是因为系统的文本选择把手、Toast 图标等仍会取主题色。 -->
    <style name="Theme.HookBrowser" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mx_accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorControlActivated">@color/mx_accent</item>
        <item name="colorControlNormal">@color/mx_track_off</item>
        <item name="android:windowBackground">@color/mx_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/mx_bg</item>
        <!-- windowLightStatusBar 不在这里写：Material3.DayNight 自己按日夜模式给值，
             无条件写死 true 会让深色模式下的状态栏图标白底白字看不见 -->
    </style>
</resources>
