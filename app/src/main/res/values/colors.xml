<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="seed">#2F6FED</color>
    <color name="ic_launcher_background">#1F2A44</color>

    <!-- ===== MIUI X 设计令牌（浅色）=====
         页面底色浅灰、内容白卡片、蓝调强调色；深色版在 values-night/colors.xml。

         ⚠ 这组值以多看 DuokanTuner 的 @color/miuix_* 为基准逐值对齐，
         另两个工程的等价定义在 DuokanTuner/res/values(-night)/colors.xml 与
         HookFanqie 的 miuix lightColorScheme/darkColorScheme。改一处要三边一起改。 -->
    <color name="mx_bg">#F2F2F7</color>
    <color name="mx_card">#FFFFFF</color>
    <color name="mx_text_primary">#191919</color>
    <color name="mx_text_secondary">#858585</color>
    <color name="mx_text_hint">#4D000000</color>
    <color name="mx_accent">#3482FF</color>
    <color name="mx_accent_soft">#1F3482FF</color>
    <color name="mx_divider">#15000000</color>
    <!-- 开关未选中轨道 / 关闭态胶囊底：实色浅灰（M3 的 surfaceContainerHighest 语义）。
         原先用的是 #26000000（15% 黑），与多看的实色 #E5E5E5 不是一回事 —— 深色下差别更大 -->
    <color name="mx_track_off">#E5E5E5</color>
    <!-- 列表行水波纹。行背景是 bg_mx_row_ripple（mask 裁到 20dp 圆角），
         色值与多看 miuix_ripple 同档（12% 主文本色） -->
    <color name="mx_ripple">#1F000000</color>
    <!-- hero 卡里实心主色胶囊上的文字色（与 material 的 colorOnPrimary 同值） -->
    <color name="mx_on_accent">#FFFFFF</color>

    <!-- ===== v2 补齐：与多看 @color/miuix_* 逐值对齐的其余语义色 ===== -->
    <!-- 输入区 / 内容块底（详情弹窗的「注意事项」也用它，此前误用 mx_accent_soft） -->
    <color name="mx_field">#F2F2F7</color>
    <!-- 轮廓（开关未选中滑块等） -->
    <color name="mx_outline">#CCCCCC</color>
    <!-- 列表右箭头 -->
    <color name="mx_arrow">#C4C4C6</color>
    <!-- 危险操作 -->
    <color name="mx_danger">#FF3B30</color>
    <!-- 主色按钮上的按压反馈 -->
    <color name="mx_ripple_on_accent">#33FFFFFF</color>
</resources>
