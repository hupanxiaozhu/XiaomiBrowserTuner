<?xml version="1.0" encoding="utf-8"?>
<!-- 胶囊底 · 开启态（状态标签 / 版本标签 / 更新日志 tag）。
     胶囊统一规范 v1：形状 stadium，圆角 = 高度 / 2。
     本 drawable 只服务「高 22dp」的标签胶囊，所以圆角写死 11dp；
     高度改了必须同步改这里，否则胶囊会退化成圆角矩形。
     ⚠ 不要再拿它当「多行内容块」的背景（100dp 那种写法会被渲染层收敛成圆角矩形，
     看着像胶囊其实不是）—— 块状用到 bg_mx_block。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/mx_accent_soft" />
    <corners android:radius="11dp" />
</shape>
